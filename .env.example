# Factor-Gated Routing — Environment Configuration
# Copy to .env and edit paths before running experiments.

# Dataset paths (REQUIRED — must point to downloaded files)
DSPRITES_PATH=/path/to/dsprites.npz
SHAPES3D_PATH=/path/to/3dshapes.h5

# Output directories (optional, defaults shown)
FGR_OUTPUT_DIR=output
FGR_ORACLE_PATH=output/oracle.pt

# GPU selection (optional)
CUDA_VISIBLE_DEVICES=0
